{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./skills"],
  "mcp": {
    "servers": {
      "hound": {
        "type": "local",
        "command": ["hound-mcp"],
        "cwd": ".",
        "environment": {
          "PYTHONUNBUFFERED": "1",
          "HOUND_MCP_ROOTS": "."
        },
        "codemode": true
      }
    }
  }
}
